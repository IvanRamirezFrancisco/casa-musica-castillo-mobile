{
  "name": "casa-musica-mobile",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "test:integration": "ng test --configuration=integration",
    "test:regression": "ng test --configuration=regression",
    "test:coverage": "ng test --configuration=ci",
    "test:white-box": "node test/run-white-box.mjs",
    "test:api": "node scripts/run-api-tests.mjs",
    "android:debug": "node scripts/build-android.mjs --environment development --variant debug",
    "android:demo": "node scripts/build-android.mjs --environment demo --variant debug",
    "android:production-debug": "node scripts/build-android.mjs --environment production --variant debug",
    "android:qa": "node scripts/build-android.mjs --environment production --variant qa",
    "android:release": "node scripts/build-android.mjs --environment production --variant release",
    "android:verify-release": "python scripts/verify-android-release.py",
    "test:build-config": "node --test test/android-build-config.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "parse5": "7.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.1",
    "@angular/language-service": "22.2.1",
    "@capacitor/cli": "8.5.2",
    "@ionic/angular-toolkit": "^13.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "angular-eslint": "22.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "4.1.12"
  },
  "description": "An Ionic project",
  "overrides": {
    "@aparajita/capacitor-secure-storage": {
      "@capacitor/core": "$@capacitor/core",
      "@capacitor/ios": "8.5.2"
    }
  }
}
